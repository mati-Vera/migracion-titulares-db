# Copiar a ".env" (nunca commitear ni pegar en el chat) y completar con los
# datos reales. El HOST:PORT es el localhost del túnel que ya abre DBeaver
# en la pestaña SSH de la conexión (no el host interno de Oracle) — con
# DBeaver conectado, ese puerto ya está escuchando en tu máquina.

DB_CONNECT_STRING=localhost:1521/NOMBRE_SERVICE
DB_USER=tu_usuario
DB_PASSWORD=tu_password
